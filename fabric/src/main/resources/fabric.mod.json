{
  "schemaVersion": 1,
  "id": "immersive_pillagers",
  "version": "${version}",
  "name": "Immersive Pillagers",
  "description": "Let the pillagers attack more creatively!",
  "authors": [
    "Luke100000"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/immersive-pillagers",
    "sources": "https://github.com/Luke100000/ImmersivePillagers",
    "issues": "https://github.com/Luke100000/ImmersivePillagers/issues"
  },
  "license": "GNU GPL 3.0",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.conczin.immersive_pillagers.fabric.ImmersivePillagersFabric"
    ],
    "client": [
      "net.conczin.immersive_pillagers.fabric.ImmersivePillagersFabricClient"
    ]
  },
  "mixins": [
    "immersive_pillagers.mixins.json",
    "immersive_pillagers-common.mixins.json"
  ],
  "depends": {
    "fabricloader": "${fabric_loader_version_range}",
    "fabric-api": "*",
    "minecraft": "${fabric_minecraft_version_range}"
  },
  "suggests": {
    "immersive_aircraft": "${fabric_immersive_aircraft_version_range}",
    "immersive_melodies": "*"
  }
}
